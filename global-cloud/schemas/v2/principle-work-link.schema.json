      "type": "string"
    },
    "role_detail": {
      "default": "",
      "maxLength": 500,
      "title": "Role Detail",
      "type": "string"
    },
    "schema_version": {
      "const": "global-principle-work-v2",
      "default": "global-principle-work-v2",
