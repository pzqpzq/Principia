{
  "additionalProperties": false,
  "properties": {
    "evidence_digest": {
      "default": "",
      "title": "Evidence Digest",
      "type": "string"
    },
    "page": {
      "anyOf": [
        {
          "maximum": 100000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page"
    },
    "principle_id": {
      "title": "Principle Id",
      "type": "string"
    },
    "principle_revision": {
      "minimum": 1,
      "title": "Principle Revision",
      "type": "integer"
    },
    "role": {
      "default": "evidence",
      "enum": [
        "evidence",
        "proof",
        "falsifier",
        "context"
      ],
