{"condition_compatibility":"compatible","confidence":0.85,"content_digest":"c04ccb4a5ab1a1c7aad8d65f8b18cddc72264d4f803f5b616431c74b1413a0c2","created_at":"2026-08-23T11:30:25+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"1536ec1b9108ee5e1b0d7df1a35aea10bf6ad2567dd64caf9c1e2ae1bf2ebd4a","input_tokens":5965,"latency_ms":33501,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"80bd25e1b5df4f67920185a4eca88704ad98d389120d49455828edf901d6d8b5","output_tokens":2562,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:f2e7907e5a46ec02d26ab081","meta_principle_id":"meta:foundations:robustness-invariance","meta_principle_revision":1,"principle_id":"prn:ai-ml:01M0Q64NEB213VQYWPWYBMM4HY","principle_revision":1,"rationale":"The claim's core inference—that qualitative agreement of prediction errors across diverse representations and learning algorithms indicates accuracy is largely independent of parametrization details—is an instance of robustness-invariance: a conclusion gains credibility when it survives irrelevant changes in model specification and analytical method. The meta-principle supports the inferential pattern, not the specific error magnitude.","relation_type":"supports","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T15:24:41+00:00","source_review_status":"unassessed","trace_id":"sync:01M0QKJMJD3A13DCG7YJ3ACW1G"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T11:30:25+00:00","variable_compatibility":"compatible"}
