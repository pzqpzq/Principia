{"condition_compatibility":"partial","confidence":0.68,"content_digest":"09a079914464ce3f67bb5f784a7c7a8b863bb1d93a3a8a8717344ff4510cc225","created_at":"2026-08-22T20:19:01+00:00","direction":"principle_to_meta","generation_trace":[{"attempts":1,"input_sha256":"f9e5079090b7970841e5895b02c4ec9bff304cd8273ce1f55092efa11dd404fa","input_tokens":5651,"latency_ms":16794,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"833596264191346e948d903bf822ea6764bffdc8416c116dea6ff53e88c22e69","output_tokens":2257,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:2abda5bceb77aae1c54dd31d","meta_principle_id":"meta:ai-ml:data-quality-ceiling","meta_principle_revision":1,"principle_id":"prn:socio-technical-systems:01M0NJ0BSADN6V1YN166FH7P3X","principle_revision":1,"rationale":"The new principle is a specialization of the data-quality ceiling: extremely close views remove contextual information from the input, so model performance is limited by missing information in the data. The meta-principle's coverage-gap boundary directly covers this missing-context condition, while the new claim remains restricted to the reported synthetic-image setting.","relation_type":"specializes","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T02:06:05+00:00","source_review_status":"unassessed","trace_id":"sync:01M0P5WC937PV7PKQMASBZ4D3Z"},"review_status":"reviewed","revision":1,"scale_compatibility":"partial","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T20:19:01+00:00","variable_compatibility":"partial"}
