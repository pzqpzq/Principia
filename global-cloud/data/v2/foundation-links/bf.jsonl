{"condition_compatibility":"compatible","confidence":0.75,"content_digest":"51ec36a6a97b9d5fc1ada77be5e710557f73baafe17861dcdd9d0969a9179708","created_at":"2026-08-22T03:25:39+00:00","direction":"principle_to_meta","generation_trace":[],"link_id":"foundation-link:09075a6732c98f787d62bba6","meta_principle_id":"meta:computer-science:reduction-completeness","meta_principle_revision":1,"principle_id":"prn:physics:01M0HFCCJ0SDK2GFBZYMKMHQ2Y","principle_revision":1,"rationale":"The claim is a specific conditional complexity-inclusion theorem built from a uniform one-query locally quantum reduction from an NP-hard problem to one-way-permutation inversion. This is a direct specialization of the general reduction-completeness principle, which states that reductions transfer difficulty and guarantees between problems and organize complexity classes. The reduction type, problem variables, and asymptotic complexity scale are compatible.","relation_type":"specializes","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T04:12:58+00:00","source_review_status":"unassessed","trace_id":"sync:01M0KTQZ6M68SKHPKARZR7EKFP"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T03:25:39+00:00","variable_compatibility":"compatible"}
