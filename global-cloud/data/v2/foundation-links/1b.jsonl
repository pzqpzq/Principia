{"condition_compatibility":"partial","confidence":0.5,"content_digest":"d41bb9d4a81435ee4b19bdb02002805dcb3996e39e13230289fd17ecbc05147d","created_at":"2026-08-23T13:31:32+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"f2ee231966eba6ae2a41c9970edebec8590c8d173c05204edac717ef544d792f","input_tokens":5887,"latency_ms":48454,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"f9383ae416a6ac0b5ace03f5139c2519b0eb324e3b28cf73cc140e67d87d35ef","output_tokens":2509,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:ab43a0311bec818a76aaa51b","meta_principle_id":"meta:ai-ml:exploration-exploitation","meta_principle_revision":1,"principle_id":"prn:mathematics-logic:01M0QD1ZWY690BK352AXJ82ZZ1","principle_revision":1,"rationale":"The meta-principle's exploration-exploitation trade-off is structurally analogous to the principle's choice between exploring all generated interpretations and committing to the strongest inference under resource limits. However, the meta-principle concerns sequential reward-driven learning, whereas the principle concerns inference search in plan recognition, so the analogy is partial and should not be treated as a direct transfer.","relation_type":"analogous_to","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T15:24:41+00:00","source_review_status":"unassessed","trace_id":"sync:01M0QKJMJD3A13DCG7YJ3ACW1G"},"review_status":"reviewed","revision":1,"scale_compatibility":"partial","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T13:31:32+00:00","variable_compatibility":"partial"}
