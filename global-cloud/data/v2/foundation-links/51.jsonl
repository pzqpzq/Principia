{"condition_compatibility":"compatible","confidence":0.68,"content_digest":"78e50f0da1e3dc901dc5874d57bbd5982a03700c793755f926c9292310319bbc","created_at":"2026-08-23T12:01:04+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"d6f64ca393f34d178edab916a1351c9dd5006a518aa76eab926004de432bb9a8","input_tokens":5879,"latency_ms":43498,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"bdb8ea55efa7f3b2d0b12c1ea83191c1176fb17a181e8bb668e4948cbf929f99","output_tokens":2377,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:ce407057eb2424b5bda45f43","meta_principle_id":"meta:socio-technical-systems:diversity-prediction-theorem","meta_principle_revision":1,"principle_id":"prn:ai-ml:01M0Q7WFKXPNBGA2AH8RC6F9PH","principle_revision":1,"rationale":"The diversity prediction theorem provides a formal mechanism for ensemble improvement: collective squared error decreases as member errors are diverse, and adding members yields diminishing gains as errors become correlated. The principle's PSNR (MSE-based) and uncertainty-spread measures are compatible with the theorem's variables, and the observed saturation around ten members is a specific instance of this general ensemble behavior.","relation_type":"generalizes","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T15:24:41+00:00","source_review_status":"unassessed","trace_id":"sync:01M0QKJMJD3A13DCG7YJ3ACW1G"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T12:01:04+00:00","variable_compatibility":"compatible"}
