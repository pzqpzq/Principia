{"condition_compatibility":"compatible","confidence":0.95,"content_digest":"ce7239cde2a82dab96f07226de969f7da8752aa16fe220b029b9cda431d98722","created_at":"2026-08-22T03:59:13+00:00","direction":"principle_to_meta","generation_trace":[],"link_id":"foundation-link:16f28a1c4f92909a3e5bbf5e","meta_principle_id":"meta:computer-science:cook-levin-np-completeness","meta_principle_revision":1,"principle_id":"prn:interdisciplinary-science:01M0HD0EEPKGEN7J85P96KB46V","principle_revision":1,"rationale":"The boundary claim about NP-hardness not automatically implying NP-completeness is grounded in the Cook-Levin requirement that NP-complete problems have polynomial-time verifiable certificates; the open Sum of Square Roots verification blocks that membership step.","relation_type":"depends_on","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T04:12:58+00:00","source_review_status":"unassessed","trace_id":"sync:01M0KTQZ6M68SKHPKARZR7EKFP"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T03:59:13+00:00","variable_compatibility":"compatible"}
{"condition_compatibility":"compatible","confidence":0.85,"content_digest":"2158ba3881105d4f9dc6ce7f9ae18f6317d290db69499f15534818efecca4285","created_at":"2026-08-22T14:55:12+00:00","direction":"principle_to_meta","generation_trace":[{"attempts":1,"input_sha256":"609e73d8179bbc3042c6f05efe13b38777b2b270efe203a8264d97157c4b9468","input_tokens":5687,"latency_ms":35557,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"f0de68fe1ce0841eecf2d5acad6b9c74922bb57b74a8ad4a3b2d160eebd7acef","output_tokens":2533,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:32e26dd663bdb8e49f82a6f0","meta_principle_id":"meta:neuroscience-cognition:stability-plasticity","meta_principle_revision":1,"principle_id":"prn:neuroscience-cognition:01M0MZEVHF0ZAXNS4ZJ21B8G5K","principle_revision":1,"rationale":"The image-fusion design rule assumes that a learning system can update weights for new tasks or methods without losing existing prior knowledge. This is the stability-plasticity dilemma, and the meta-principle identifies the complementary mechanisms needed to reduce catastrophic interference. The principle's feasibility therefore depends on the stability-plasticity principle, although the meta-principle does not guarantee full independence from imaging attributes or data distributions.","relation_type":"depends_on","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T14:55:12+00:00","variable_compatibility":"compatible"}
