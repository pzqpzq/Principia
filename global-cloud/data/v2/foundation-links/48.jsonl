{"condition_compatibility":"compatible","confidence":0.85,"content_digest":"d4dc8a269fa78a19f63a3f767d096a2456f0429de49b66160cf9d7a99d06c6f6","created_at":"2026-08-22T15:35:32+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"2ff43c3d7ae36ea32a73a0b374e2fe9de2330e2082b7bbbbedfe78c45ceba915","input_tokens":5565,"latency_ms":46042,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"c413a1c5f10d487e83aa873d11cc0ef0e09a0ac4ea35cb46aac9a5d0fee42541","output_tokens":2532,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:4f7812ceabaa6405d6a35c9a","meta_principle_id":"meta:foundations:mechanism-prediction-distinction","meta_principle_revision":1,"principle_id":"prn:neuroscience-cognition:01M0N1RCD8EJPB02MWPAPT8GDH","principle_revision":1,"rationale":"The principle establishes a predictive correspondence between model internal representations and neural firing, not a mechanistic identity. The meta-principle bounds the interpretation by distinguishing predictive success from mechanistic truth, preventing the empirical association from being overread as proof that the brain uses the same recurrent-network mechanism.","relation_type":"bounded_by","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T15:35:32+00:00","variable_compatibility":"compatible"}
{"condition_compatibility":"compatible","confidence":0.62,"content_digest":"e6e0f2e92b2066f4c96dad506756693150791f10988ef881eb793528be047c20","created_at":"2026-08-22T22:16:57+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"bc77f8cfc66a830ef0d3429ebd9fafc8af394c92d1e1de2bbc5e4526c7dab387","input_tokens":2495,"latency_ms":16125,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"d0751738b717191574357402c5ebaafb49b4c89033c46945c686b641920ad9e2","output_tokens":2405,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:8e185be01246f3de81ac8339","meta_principle_id":"meta:foundations:robustness-sensitivity","meta_principle_revision":1,"principle_id":"prn:ai-ml:01M0NRRAZ7KFNPFFPTWDQB14VA","principle_revision":1,"rationale":"The meta-principle requires a claimed relation to be credible across plausible perturbations and to have its generalization bounded by sensitivity analysis. The principle is explicitly study-bound to the contact-center transcript domain and the specific 3D alignment procedure, and its falsifier/testability statement calls for evaluation on different judges and corpora. Thus the meta-principle appropriately bounds the scope of the claim without asserting that the claim is true.","relation_type":"bounded_by","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T02:58:57+00:00","source_review_status":"unassessed","trace_id":"sync:01M0P5WC937PV7PKQMASBZ4D3Z"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T22:16:57+00:00","variable_compatibility":"partial"}
