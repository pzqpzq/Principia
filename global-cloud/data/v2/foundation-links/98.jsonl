{"condition_compatibility":"partial","confidence":0.55,"content_digest":"9bef56049d4ce8a073cd1accfd50d1fb94cde055a13d46aaa66615e64daae594","created_at":"2026-08-23T04:38:21+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"d34405c9e80cee3eb7136b500f953f8b4fb284769ba4e2f4927364d94daf5454","input_tokens":5808,"latency_ms":49000,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"3fe4174271e733b0a3afdd993d89f6e78cec2901a95513991221c4f60cbcd247","output_tokens":2866,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:c7dd7a757e56e68e7b549176","meta_principle_id":"meta:foundations:uncertainty-propagation","meta_principle_revision":1,"principle_id":"prn:biology-evolution:01M0PEHP33RSP0BSM4DN1PR1DR","principle_revision":1,"rationale":"The meta-principle states that uncertainty in outputs must reflect input uncertainties and that nonlinear systems may require simulation or interval methods. The new principle is consistent with this because it shows that uncertainty reduction at one condition does not automatically propagate to a different prediction condition in a nonlinear system. The relation is not a strict support because the meta-principle does not by itself predict the specific failure of cross-condition uncertainty reduction.","relation_type":"consistent_with","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T08:08:08+00:00","source_review_status":"unassessed","trace_id":"sync:01M0PTK9G6V6VXNVFWAWBHMSYT"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T04:38:21+00:00","variable_compatibility":"partial"}
