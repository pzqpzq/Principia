{"condition_compatibility":"partial","confidence":0.5,"content_digest":"dddb24e6645c4419277c0fa0aca3ac8b98b07b266cac1cd99b9bd4f01bd50ec6","created_at":"2026-08-22T14:34:06+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"91b5ffa8055dbad2f5af574c9e071b04e0db5de2ced19b78182cccfaca902c86","input_tokens":5460,"latency_ms":35322,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"bc55bf62ad65406fc1059aa5b009bd8a3c22f0174744c39833d95f7d90a5bd91","output_tokens":2631,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:9399bd886475c578dc5d24f7","meta_principle_id":"meta:neuroscience-cognition:attractor-dynamics","meta_principle_revision":1,"principle_id":"prn:medicine-epidemiology:01M0MY878V9YJ8758XP88TPNRJ","principle_revision":1,"rationale":"Attractor dynamics show that recurrent networks can maintain stable or metastable activity patterns, and changes in network connectivity can alter attractor landscapes. This is consistent with the idea that small connectivity changes could shift the brain into a disorder-related attractor state. However, the meta-principle does not specify pathological transitions, and fitted attractor states do not prove causal disorder mechanisms, so the relation is suggestive rather than definitive.","relation_type":"consistent_with","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T14:34:06+00:00","variable_compatibility":"partial"}
