{"condition_compatibility":"partial","confidence":0.45,"content_digest":"73351a4ebae7e2b6362a9fce5f000dca0712e0ae7e0ef7aa8adc2687e2b2134d","created_at":"2026-08-22T22:32:07+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"f34695d1587ae5e1e55b517a29b51a32a2a14f1ec7ac6ccdef29ed3e8ff84185","input_tokens":5183,"latency_ms":21035,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"c7063ffbbc3a9427f2f47f8a0b815ad8e8f3bba7f5e988ab7294db6ded7fec5a","output_tokens":2347,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:cc7de6b3595dc47a3a8fdb31","meta_principle_id":"meta:scientific-discovery:active-learning","meta_principle_revision":1,"principle_id":"prn:scientific-discovery:01M0NSKYNYWKV22GAVD9GCG4XD","principle_revision":1,"rationale":"Both the Meta-Principle and the claim use model uncertainty to target where additional information is most needed. Active learning requests labels or measurements where they most improve the model; the claim forms retrieval queries from low-confidence tokens to supply information the LLM lacks. The analogy is suggestive but not a direct dependency because active learning is a training-time iterative loop while the claim is an inference-time retrieval strategy without model update.","relation_type":"analogous_to","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T02:06:05+00:00","source_review_status":"unassessed","trace_id":"sync:01M0P5WC937PV7PKQMASBZ4D3Z"},"review_status":"reviewed","revision":1,"scale_compatibility":"partial","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T22:32:07+00:00","variable_compatibility":"partial"}
