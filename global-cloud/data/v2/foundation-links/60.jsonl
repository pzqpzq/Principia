{"condition_compatibility":"compatible","confidence":0.82,"content_digest":"9ad6603b30a73bb7f361534094d52f9ff39f432f1defe9f638d41ba4a7e8cd6c","created_at":"2026-08-22T03:40:41+00:00","direction":"meta_to_principle","generation_trace":[],"link_id":"foundation-link:5195b2527535233c4953aa75","meta_principle_id":"meta:computer-science:amdahl-law","meta_principle_revision":1,"principle_id":"prn:general:01M0AVZGCG1H4A8FYJA7G1133J","principle_revision":1,"rationale":"Amdahl's law states that the overall speedup obtainable by optimizing a component is limited by the fraction of execution time that component occupies. The principle applies this logic to LLM post-training rollout: because rollout dominates execution time, optimizing it is the primary lever for reducing end-to-end cost. The meta-principle provides the general performance-bound rationale, while the principle supplies the workload-specific instantiation.","relation_type":"supports","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T04:12:58+00:00","source_review_status":"unassessed","trace_id":"sync:01M0KTQZ6M68SKHPKARZR7EKFP"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T03:40:41+00:00","variable_compatibility":"compatible"}
