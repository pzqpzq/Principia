{"condition_compatibility":"compatible","confidence":0.92,"content_digest":"8bb4528e54d05cbfac296d5fb4962fc546dc1c745d5c489804bff8ab92008dd4","created_at":"2026-08-22T16:24:25+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"e925c81d8e57daec9a3371bc0df314cb085f2f61a6338e49644abe10993b6d11","input_tokens":6042,"latency_ms":49300,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"2008c90d4a24b14c25502d800ab74b8acf739dab6923e604d1cee434bbcb802b","output_tokens":2471,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:266201bfa66bb452958c45d1","meta_principle_id":"meta:foundations:measurement-validity","meta_principle_revision":1,"principle_id":"prn:ai-ml:01M0N4HSWT0EPTRSE2TJC21225","principle_revision":1,"rationale":"The meta-principle states that a number is informative only if the measurement operation tracks the intended construct with adequate invariance. The new principle identifies specific methodological features—mode, order, fatigue, examples, interface, wording—that can change response meaning and thereby reduce internal validity. Thus the general measurement-validity principle directly supports the claim that method effects threaten human baseline measurements.","relation_type":"supports","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T16:24:25+00:00","variable_compatibility":"compatible"}
