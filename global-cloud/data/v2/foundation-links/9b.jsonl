{"condition_compatibility":"compatible","confidence":0.95,"content_digest":"dca46f7339b1c2ffeaa3e0a00f00a35f63a1c0dada0c088b1994710d562ca895","created_at":"2026-08-22T14:34:37+00:00","direction":"principle_to_meta","generation_trace":[{"attempts":1,"input_sha256":"47f90f5763e6b50e9e0b10bf2694b730e6203c979dd6d5431f9b0de843efa2a8","input_tokens":5588,"latency_ms":30042,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"f42216043af9108a20d5de3f4afc073186e986269e226d7bf73b7245a9b2e8e0","output_tokens":2335,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:77838e1fa381987bd959908d","meta_principle_id":"meta:neuroscience-cognition:degeneracy","meta_principle_revision":1,"principle_id":"prn:medicine-epidemiology:01M0MY9AS7P12BXY4QSB142X7V","principle_revision":1,"rationale":"The claim that many structurally different connectome patterns yield the same cognitive-deficit phenotype is a specific instance of the degeneracy principle, which states that structurally different components can perform the same function or yield the same output. The principle's conditions, variables, and scale align with the meta-principle's scope, particularly its application to neural circuits and functional outputs.","relation_type":"specializes","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T14:34:37+00:00","variable_compatibility":"compatible"}
