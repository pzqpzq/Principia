{"condition_compatibility":"compatible","confidence":0.76,"content_digest":"fff54b089a01ed96c2a7022718ef739a83bf5c92328e45f0f91db544344e8ae1","created_at":"2026-08-22T03:44:20+00:00","direction":"meta_to_principle","generation_trace":[],"link_id":"foundation-link:729d324e0bd384364294b737","meta_principle_id":"meta:socio-technical-systems:campbells-law","meta_principle_revision":1,"principle_id":"prn:general:01M0AZY4FE3RTG16KQCZVY4JTS","principle_revision":1,"rationale":"The claim that output-level metrics can indicate high unlearning success while internal knowledge remains is a direct instance of proxy corruption: when an output-level indicator is used to select or evaluate unlearning, it can be optimized without faithfully reflecting the underlying internal erasure construct.","relation_type":"supports","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T04:12:58+00:00","source_review_status":"unassessed","trace_id":"sync:01M0KTQZ6M68SKHPKARZR7EKFP"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T03:44:20+00:00","variable_compatibility":"compatible"}
