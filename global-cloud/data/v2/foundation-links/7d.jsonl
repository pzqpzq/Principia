{"condition_compatibility":"compatible","confidence":0.68,"content_digest":"415d0daf88c7b3299755fdba516c563d46b5b67ccc8d89a80ab6a3071cc17441","created_at":"2026-08-23T11:18:48+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"d61503a6f20cff0c022905d2c26669541f29b4d45ab0f8474dbe0134b91db0d7","input_tokens":5815,"latency_ms":32744,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"75f45aa44aecfe23ea5145f585df7b6fd26e8f98a0ec023a41395544acaaf3ae","output_tokens":2405,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:4628a0f64f7b0dc62cdf251a","meta_principle_id":"meta:foundations:robustness-sensitivity","meta_principle_revision":1,"principle_id":"prn:ai-ml:01M0Q5FDGNVP9NYRDHNP8CXQTW","principle_revision":1,"rationale":"The meta-principle requires credible relations to survive plausible perturbations and identifies fragile analytical choices through sensitivity analysis. Shuffling entity order is a plausible perturbation of the evaluation protocol; the observed performance drop demonstrates that the measured score is sensitive to this choice and should not be read as a stable capability estimate.","relation_type":"consistent_with","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T15:24:41+00:00","source_review_status":"unassessed","trace_id":"sync:01M0QKJMJD3A13DCG7YJ3ACW1G"},"review_status":"reviewed","revision":1,"scale_compatibility":"partial","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T11:18:48+00:00","variable_compatibility":"partial"}
{"condition_compatibility":"partial","confidence":0.7,"content_digest":"b4301f874bc59e82186d8952f58b08b451f84c2b0cb5a0ee86f4fc2e3c122ea3","created_at":"2026-08-22T15:26:54+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"33d282c8e08ff2847a52c34f6a7e2a007a58424235742705dd29423e2d3a4d5f","input_tokens":5782,"latency_ms":35961,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"60101a0c708ab78bb0a800ba5278f8685ee90eed254e211d00766c6c8e9c78dc","output_tokens":2452,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:4c641289f1be9c9598faa3eb","meta_principle_id":"meta:foundations:multiple-testing-selection","meta_principle_revision":1,"principle_id":"prn:neuroscience-cognition:01M0N18WZ8QJDYJQ6HEPEA6CS8","principle_revision":1,"rationale":"The claim's accuracy comparison between ECG-derived and EEG-based inference is only trustworthy if the cross-modal regression pipeline was not selected by exploiting search multiplicity. The stated falsifier uses a held-out dataset, which is the kind of validation required by the meta-principle; the claim is therefore bounded by this statistical selection constraint.","relation_type":"bounded_by","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T15:26:54+00:00","variable_compatibility":"compatible"}
{"condition_compatibility":"partial","confidence":0.65,"content_digest":"a54f8c3229c1333e22c5187e1320fb7eb160f7edb8736ff4e170338aab859e60","created_at":"2026-08-22T21:22:47+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"3c5d5204ff8338d95af90628766ca58b461c2e5797d9a1b0b003bb90ef669052","input_tokens":5556,"latency_ms":30763,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"759ef65802bb5bbbc96117cfda9ff0344e8fa14c87ad7497cd7e918bb1f676ab","output_tokens":2838,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:56565a5f3ada4661ac76a222","meta_principle_id":"meta:scientific-discovery:benchmark-saturation-leakage","meta_principle_revision":1,"principle_id":"prn:ai-ml:01M0NNMP253KTJ6CN4M7DCQBGF","principle_revision":1,"rationale":"If the survey-generation evaluation protocol is used as a benchmark and its test items become contaminated, saturated, or repeatedly optimized against, the measured alignment with human experts can become benchmark-specific adaptation rather than a stable property of the protocol. This bounds the claim to genuinely held-out and non-saturated evaluation conditions.","relation_type":"bounded_by","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T02:58:57+00:00","source_review_status":"unassessed","trace_id":"sync:01M0P5WC937PV7PKQMASBZ4D3Z"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T21:22:47+00:00","variable_compatibility":"compatible"}
{"condition_compatibility":"compatible","confidence":0.6,"content_digest":"1b8bbb6ae3d8b59bb49e3e771369a44bfae9ec345c3551d734ca2fcf6840e3f6","created_at":"2026-08-22T19:31:17+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"97769a04076777885eb330ecbfc4cb6c6ce83299cd9ccb381e867f197886ca0d","input_tokens":5706,"latency_ms":21178,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"b4647c2578d2080765c76981ccfe1ebaacfcb83267eb4383ae6657ff9cf01f53","output_tokens":2482,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:cc6d377736d5180266123905","meta_principle_id":"meta:neuroscience-cognition:efficient-coding","meta_principle_revision":1,"principle_id":"prn:neuroscience-cognition:01M0NF8TC61HSMNA7CK46ES74N","principle_revision":1,"rationale":"The efficient-coding meta-principle holds that sensory systems adapt codes to input statistics and resource constraints. The new principle's finding that sparse coding efficiency is optimized at parameter values matching V1 selectivity is consistent with the efficient-coding hypothesis, though the new principle does not establish the broader hypothesis by itself.","relation_type":"consistent_with","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T02:58:57+00:00","source_review_status":"unassessed","trace_id":"sync:01M0P5WC937PV7PKQMASBZ4D3Z"},"review_status":"reviewed","revision":1,"scale_compatibility":"partial","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T19:31:17+00:00","variable_compatibility":"partial"}
{"condition_compatibility":"compatible","confidence":0.82,"content_digest":"0530ed3834ed0ae94bf03fc7c7e1b130b64703aaa100671c077d21a2c1dfc850","created_at":"2026-08-22T15:28:16+00:00","direction":"principle_to_meta","generation_trace":[{"attempts":1,"input_sha256":"500989856546bdae95b034ed7fa30d8b042baca134628e6541dc64ecd5ca004a","input_tokens":5923,"latency_ms":40979,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"b3d7ea5d987a97ae2222425dfb9702434d585fbc50b3e7c9ae848ef16888a6da","output_tokens":2728,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:f4b00674b347e6ecdca4b588","meta_principle_id":"meta:ai-ml:data-quality-ceiling","meta_principle_revision":1,"principle_id":"prn:neuroscience-cognition:01M0N1B7TZ0G0VZSG50WHHBHSG","principle_revision":1,"rationale":"The EEG/ECG claim is a specific case of the general principle that model performance is bounded by the information present in the data: using only one modality removes the largely orthogonal information carried by the other, so classifier accuracy is driven toward chance. The variables (available signal information vs. classifier performance), conditions (brain-state classification), and scale (single-modality vs. multimodal inputs) are compatible with the meta-principle's scope.","relation_type":"specializes","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T15:28:16+00:00","variable_compatibility":"compatible"}
