{"condition_compatibility":"compatible","confidence":0.72,"content_digest":"985c0aad6893ec72d9c1857fd943c45f7442074accd8fb9e12cafb94a8f5485c","created_at":"2026-08-22T03:44:33+00:00","direction":"meta_to_principle","generation_trace":[],"link_id":"foundation-link:1ac880b85ee7c165ae13988c","meta_principle_id":"meta:ai-ml:data-quality-ceiling","meta_principle_revision":1,"principle_id":"prn:general:01M0B22TAWR1HXH5M4024P3CTE","principle_revision":1,"rationale":"The data-quality-ceiling principle states that learning systems inherit biases present in their training data and cannot recover distinctions absent from observations. The literature claim that post-training shifts LLM preferences toward the developer's regional alignment is a specific case of this inheritance mechanism: post-training data and alignment choices carry geopolitical biases that become encoded in the model.","relation_type":"supports","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T04:12:58+00:00","source_review_status":"unassessed","trace_id":"sync:01M0KTQZ6M68SKHPKARZR7EKFP"},"review_status":"reviewed","revision":1,"scale_compatibility":"partial","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T03:44:33+00:00","variable_compatibility":"compatible"}
