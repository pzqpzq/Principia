{"condition_compatibility":"compatible","confidence":0.68,"content_digest":"caef8ebd23793c2a30f7b4afc708ef556a022e616e1313ff5b41365fde1a2f78","created_at":"2026-08-23T05:22:09+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"5337c122d0a7ea1f7cc2221d0e8081fd9fc72f143758e1edb1d53ea6e5778684","input_tokens":5878,"latency_ms":26842,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"1cf00200d8e375f2ecf2f992918148d17dab03f40f5b3d2d05b52be6d38ea24a","output_tokens":2552,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:fed8da3d5e1114ea2507e9f5","meta_principle_id":"meta:ai-ml:bitter-lesson","meta_principle_revision":1,"principle_id":"prn:scientific-discovery:01M0PH2JC32YVANQ86WWWTWD5G","principle_revision":1,"rationale":"The bitter-lesson meta-principle advises encoding domain structure only where it complements scalable search and learning. The principle exemplifies this by showing that the domain-specific SEDS model is justified in opening and non-fighting positions, where it complements MCTS, but not in endgame or all-or-nothing fights, where its blind spots dominate.","relation_type":"consistent_with","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T08:08:08+00:00","source_review_status":"unassessed","trace_id":"sync:01M0PTK9G6V6VXNVFWAWBHMSYT"},"review_status":"reviewed","revision":1,"scale_compatibility":"partial","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T05:22:09+00:00","variable_compatibility":"partial"}
