{"condition_compatibility":"compatible","confidence":0.9,"content_digest":"23ef60e9f5f6e63824cc243a6735088e4de1037d328e9836aa0a12751c6bbb3f","created_at":"2026-08-23T04:16:27+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"4db2a8679ff37aed002a43b6ba7eeb85655ebb145d82634191184764a12bb0b9","input_tokens":5988,"latency_ms":39752,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"55eec82951a58d318b1150c1953573040f028f54a7c636b6ec001c9501f9699b","output_tokens":2394,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:5d847ff102505c63c9ed7cfa","meta_principle_id":"meta:computing-industry:roofline-model","meta_principle_revision":1,"principle_id":"prn:neuroscience-cognition:01M0PD9WBBN2W1XV04DYYZ7B1H","principle_revision":1,"rationale":"The roofline model establishes that kernel performance is bounded by compute throughput and memory bandwidth according to arithmetic intensity. The principle's claim that rank-2 spmm outperforms rank-1 spmv because of higher arithmetic intensity is a direct application of this model at fixed problem size and thread count. Conditions, variables, and scale align: both concern kernel-level execution on a fixed computational resource, with arithmetic intensity as the key explanatory variable.","relation_type":"supports","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T08:08:08+00:00","source_review_status":"unassessed","trace_id":"sync:01M0PTK9G6V6VXNVFWAWBHMSYT"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T04:16:27+00:00","variable_compatibility":"compatible"}
