{"condition_compatibility":"compatible","confidence":0.75,"content_digest":"3a18f6f55bd67538ae9678f36fb5e276aed9abca9e3ed45fc744e7522b51b3cc","created_at":"2026-08-22T03:44:27+00:00","direction":"meta_to_principle","generation_trace":[],"link_id":"foundation-link:ca744c7e14f25088375320ae","meta_principle_id":"meta:ai-ml:credit-assignment","meta_principle_revision":1,"principle_id":"prn:general:01M0B1JQ8GAFJRYRFF288V2N0J","principle_revision":1,"rationale":"The meta-principle that learning requires assigning outcomes to responsible internal decisions supports the claim that dense verifier-derived rewards improve sample efficiency and final success. Dense rewards provide more frequent and informative credit signals than sparse rewards, which is a direct application of improved credit assignment in reinforcement learning.","relation_type":"supports","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T04:12:58+00:00","source_review_status":"unassessed","trace_id":"sync:01M0KTQZ6M68SKHPKARZR7EKFP"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T03:44:27+00:00","variable_compatibility":"compatible"}
