{"condition_compatibility":"compatible","confidence":0.9,"content_digest":"96be45c35586337c284d8a43fa35e6db02bd20b63e09ad63d31b7f6db53be95c","created_at":"2026-08-23T04:16:09+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"3fa0df885ae002d575e63bee2189e034aec2501de4d7b512384aeeb4338bcb90","input_tokens":5729,"latency_ms":33483,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"5d289a7cbb881782762aae72b4b9caf6834b4f64385f883ae31a57c15f865bec","output_tokens":2511,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:bc42ab60bade1a6d09ff90c5","meta_principle_id":"meta:mathematics-logic:proof-model-distinction","meta_principle_revision":1,"principle_id":"prn:biology-evolution:01M0PD9GWQA9VGRZSHVN8E8AEJ","principle_revision":1,"rationale":"The principle is a formal consequence within a mathematical model of finite-state random dynamical systems. The proof-model distinction states that formal proof validity does not automatically transfer to empirical systems; the principle's own boundary—limiting evidence to formal proof conditions—is exactly the kind of limitation this meta-principle articulates.","relation_type":"bounded_by","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T08:08:08+00:00","source_review_status":"unassessed","trace_id":"sync:01M0PTK9G6V6VXNVFWAWBHMSYT"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T04:16:09+00:00","variable_compatibility":"compatible"}
{"condition_compatibility":"compatible","confidence":0.72,"content_digest":"852a135a6cf800c8ba8bc63f01aca9d4d8ad437575dfc5ade9c80b57b04c4708","created_at":"2026-08-22T18:39:09+00:00","direction":"principle_to_meta","generation_trace":[{"attempts":1,"input_sha256":"93cce79c6f924a358455a12f82f9dd7024e74bd37c8787e05755eb3c13c0309c","input_tokens":5606,"latency_ms":29628,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"18fa3ae33f4e09f67b6c50241e3ac5e31dd992b724e7510e6496088ec166a5f5","output_tokens":2545,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:c68921ae5e69d8a59c67f387","meta_principle_id":"meta:ai-ml:inductive-bias","meta_principle_revision":1,"principle_id":"prn:ai-ml:01M0NC9438DSE4YDYA9T194FGQ","principle_revision":1,"rationale":"Feature extraction and data representation methods are a concrete form of inductive bias: they constrain the hypothesis space or representation so that a learner can generalize from finite data. The meta-principle states that generalization requires such bias, and the principle applies this to reducing the amount of training data needed. The relation is compatible because the principle operates within the same machine-learning setting and its 'can reduce' qualifier respects the meta-principle's boundary that bias is not universally beneficial.","relation_type":"specializes","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T02:58:57+00:00","source_review_status":"unassessed","trace_id":"sync:01M0P5WC937PV7PKQMASBZ4D3Z"},"review_status":"reviewed","revision":1,"scale_compatibility":"partial","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T18:39:09+00:00","variable_compatibility":"partial"}
