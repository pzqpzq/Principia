{"condition_compatibility":"compatible","confidence":0.68,"content_digest":"791f3d7a6d7517c15bc6f86f7477ad16b559c9c5631a9559d31747324d62a14f","created_at":"2026-08-23T06:15:22+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"667875d3e6a62a0e1cbc557e29a3fd60dd9da5c21522dfde2aa9ab8bf2b84f62","input_tokens":6591,"latency_ms":34792,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"539f7cb471e7eefda09c45adb55dcdc65132bfb58ec64e374f0e93065b901c47","output_tokens":2475,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:db832325a506b4dff0e4b9de","meta_principle_id":"meta:mathematics-logic:proof-model-distinction","meta_principle_revision":1,"principle_id":"prn:physics:01M0PM3RQ5X8GEA5BNC0F5XDQS","principle_revision":1,"rationale":"The classification of band patterns is a formal result about the reduced dynamical system; applying it to real polar active matter requires that the hydrodynamic model and traveling-wave assumptions adequately represent the physical system. The meta-principle's distinction between proof validity and empirical model adequacy directly bounds the principle's transferability, matching the stated boundary that evidence is limited to the reported equations and parameter regimes.","relation_type":"bounded_by","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T08:08:08+00:00","source_review_status":"unassessed","trace_id":"sync:01M0PTK9G6V6VXNVFWAWBHMSYT"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T06:15:22+00:00","variable_compatibility":"compatible"}
