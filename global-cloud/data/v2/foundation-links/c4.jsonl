{"condition_compatibility":"partial","confidence":0.55,"content_digest":"3f649d290d560f48a6be6b044fb49847302bb198559c10f5ff4f058ed0bebdbc","created_at":"2026-08-22T19:30:10+00:00","direction":"principle_to_meta","generation_trace":[{"attempts":1,"input_sha256":"827896f84a25c532c2d1d5177cfb1b4695bd9bcc09fac8b9f95c0991bb104d53","input_tokens":5611,"latency_ms":17181,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"9af9f6fb3712422ecac69e993a8bdae6fb5d1df1f06b5dac26e3c0cb217f34b9","output_tokens":2739,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:b23db2b4e2380dfd916831e8","meta_principle_id":"meta:foundations:triangulation","meta_principle_revision":1,"principle_id":"prn:neuroscience-cognition:01M0NF6XATFSPGC4151CJAYZW7","principle_revision":1,"rationale":"Comparing different sparse coding schemes on the same data is structurally analogous to triangulation across methods with different assumptions: convergence of qualitatively similar edge-like filters across algorithms suggests the result is not an artifact of one coding scheme. The analogy is limited because the schemes may share common assumptions and the principle is study-bound, so it is proposed only as an analogy, not as evidence of methodological triangulation.","relation_type":"analogous_to","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T02:58:57+00:00","source_review_status":"unassessed","trace_id":"sync:01M0P5WC937PV7PKQMASBZ4D3Z"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T19:30:10+00:00","variable_compatibility":"partial"}
