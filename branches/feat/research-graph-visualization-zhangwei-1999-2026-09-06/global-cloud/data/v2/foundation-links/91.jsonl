{"condition_compatibility":"compatible","confidence":0.85,"content_digest":"3292aa83a1474a3e0c1bb415eda84377e95c96e49c1d1b9b6b53e0b648af3e65","created_at":"2026-08-22T21:51:49+00:00","direction":"principle_to_meta","generation_trace":[{"attempts":1,"input_sha256":"15567e0260cc1ff911e6e4c2bbce5ef1cbbfae38271a42e7c4f2921daa8b4ea6","input_tokens":5651,"latency_ms":21104,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"c51c531d1b58dcc002abf205d2f48ad707c3ee9b75e2ffc5becefd9f4702cab2","output_tokens":2322,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:187228eee57d6cfd94923376","meta_principle_id":"meta:computer-science:reduction-completeness","meta_principle_revision":1,"principle_id":"prn:mathematics-logic:01M0NQA54AGBQ9TX3SYD42NCC9","principle_revision":1,"rationale":"The claim is a concrete instance of the general reduction principle: it transforms a truthfulness property-testing problem into a monotonicity-variant testing problem while preserving the relevant testing guarantees. The meta-principle supplies the general framework for such reductions, and the principle specializes it to single-parameter domains.","relation_type":"specializes","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T02:58:57+00:00","source_review_status":"unassessed","trace_id":"sync:01M0P5WC937PV7PKQMASBZ4D3Z"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T21:51:49+00:00","variable_compatibility":"compatible"}
