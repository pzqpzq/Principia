{"condition_compatibility":"compatible","confidence":0.78,"content_digest":"14d02e92cd03186fd916d9b6ec85cb392c87508adb2356617ba8a897979fa1ea","created_at":"2026-08-23T11:10:40+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"424e715a522fb914a97086118751a645ccb7f777dbbd0e9048ad8ec8d746a4b9","input_tokens":5429,"latency_ms":31206,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"61f53643ab3fa392a4af5b197a8af898f390214ef015d0611f88f5b35b754449","output_tokens":2380,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:be1e6d9b8ef60b8d1b5da479","meta_principle_id":"meta:ai-ml:inductive-bias","meta_principle_revision":1,"principle_id":"prn:chemistry-materials:01M0Q50JMXMTCMDT3FYFB6T4MG","principle_revision":1,"rationale":"The meta-principle states that generalization requires inductive bias and explicitly lists pretraining as a source of bias. Domain-specific pretraining on alloy literature is an inductive bias tailored to the alloy-property prediction environment, which supports the observed predictive-accuracy advantage over general-purpose BERT. The computational-efficiency outcome is outside the meta-principle's scope, hence partial variable compatibility.","relation_type":"supports","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T15:24:41+00:00","source_review_status":"unassessed","trace_id":"sync:01M0QKJMJD3A13DCG7YJ3ACW1G"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T11:10:40+00:00","variable_compatibility":"partial"}
