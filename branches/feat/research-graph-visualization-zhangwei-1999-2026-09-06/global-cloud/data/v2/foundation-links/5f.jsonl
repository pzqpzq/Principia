{"condition_compatibility":"compatible","confidence":0.72,"content_digest":"5014ad9825aded9a2a35495a901e0d4499094eb3202fc72120fae79e94f40a50","created_at":"2026-08-23T13:37:50+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"f49fe2f1a8ccccf756873a6183e1c0a5c81a7a1037a4dda89bb5c3ce10e46c36","input_tokens":5877,"latency_ms":34997,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"c3db54b24b98abc889c9947757133b6dea5bf007e89df54272ef2fef9e2dcd61","output_tokens":2487,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:2ef63545a77c2704fbc6e58a","meta_principle_id":"meta:economics-game-theory:nash-equilibrium","meta_principle_revision":1,"principle_id":"prn:scientific-discovery:01M0QDDYKT605M7JZZPCDPQ1SR","principle_revision":1,"rationale":"Both are equilibrium-existence theorems for finite games with mixed strategies, but they concern different solution concepts: Nash equilibrium is mutual best response, while minimax-regret equilibrium minimizes maximum regret over other agents' type realizations. The analogy is structural and does not imply that minimax-regret equilibria are Nash equilibria.","relation_type":"analogous_to","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T15:24:41+00:00","source_review_status":"unassessed","trace_id":"sync:01M0QKJMJD3A13DCG7YJ3ACW1G"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T13:37:50+00:00","variable_compatibility":"compatible"}
