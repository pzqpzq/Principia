{"condition_compatibility":"compatible","confidence":0.85,"content_digest":"b8dddb5de1ab2ea706a208fe6c50329724170951f48f1bd189b6ae682acba60a","created_at":"2026-08-22T15:00:22+00:00","direction":"principle_to_meta","generation_trace":[{"attempts":1,"input_sha256":"fda9ff7928c9a2a4dd9e23506041fb4a77711909e3a12159dee04ff17508e922","input_tokens":5450,"latency_ms":38921,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"b3e46832b937691ba4dfb25b98e964c3197a6ccbe942ed156a054a508d852619","output_tokens":2514,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:b17625df47d2f207fd5dfce1","meta_principle_id":"meta:neuroscience-cognition:integration-segregation","meta_principle_revision":1,"principle_id":"prn:neuroscience-cognition:01M0MZR741NJS4TKZNZR1C3BGW","principle_revision":1,"rationale":"The new principle is a study-bound, directional specification of the broader integration-segregation principle: it asserts that local modular processing enables global integrative processing in the human brain, whereas the meta-principle describes the general coexistence and coordination of segregation and integration in neural systems. The variables (local specialized processing and global integration) and the system (brain networks) align, and the meta-principle's boundary conditions about scale and measurement are compatible with the principle's conservative study-bound scope.","relation_type":"specializes","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","update