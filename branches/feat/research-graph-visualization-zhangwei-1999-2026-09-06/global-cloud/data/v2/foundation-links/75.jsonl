{"condition_compatibility":"partial","confidence":0.6,"content_digest":"1605ee468b688a84a78b549c2559573454704dde396c4a774075cbd4aef69763","created_at":"2026-08-22T16:07:21+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"44385465868cc1637ec6ecaee1fb6ed4f2715517177adcc9673be06e9ea5f7cd","input_tokens":5588,"latency_ms":34099,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"7e370c8d07f17b1a21884c0001b2dc6529064e3323b6888a7898e9a96d3a293b","output_tokens":2645,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:fb9b9c46e071afc564908f1b","meta_principle_id":"meta:foundations:robustness-invariance","meta_principle_revision":1,"principle_id":"prn:neuroscience-cognition:01M0N3K0JHVCDSGTREXRGV5TGY","principle_revision":1,"rationale":"The principle's demand that invariance be explicitly declared rather than assumed from a stable score is consistent with the robustness-invariance emphasis that invariance across relevant changes must be examined rather than inferred from superficial stability. The principle applies this idea to measurement of cognitive load in disclosure processing.","relation_type":"consistent_with","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"partial","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T16:07:21+00:00","variable_compatibility":"partial"}
