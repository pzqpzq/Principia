{"condition_compatibility":"compatible","confidence":0.82,"content_digest":"bc32bbf87035c2f1bf37e4d92203fe3c9125f4898158ac766ca9c23ac50da26e","created_at":"2026-08-22T22:31:46+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"82064c42b5d81695ef69e4ad24f2371984d79215025123a4ba36d385436e5777","input_tokens":5714,"latency_ms":17880,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"aa995328eb35f03eee42c2d7210fa984c6c7704881f57650b6b09ec15844e0d1","output_tokens":2585,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:0ba48487eab1e62a906158ac","meta_principle_id":"meta:ai-ml:compute-data-model-codesign","meta_principle_revision":1,"principle_id":"prn:scientific-discovery:01M0NSKCQNQEGCT0FRBEZ3ATM3","principle_revision":1,"rationale":"The meta-principle states that under a fixed budget, performance depends on how capacity, data, optimization, and deployment cost are allocated. The principle applies this to LLM adaptation: updating via pre-training or SFT consumes prohibitive compute, while using external sources at inference reallocates the budget toward data and inference rather than model updating. The principle is a concrete specialization of co-design under budget constraints.","relation_type":"generalizes","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T02:58:57+00:00","source_review_status":"unassessed","trace_id":"sync:01M0P5WC937PV7PKQMASBZ4D3Z"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T22:31:46+00:00","variable_compatibility":"compatible"}
{"condition_compatibility":"compatible","confidence":0.8,"content_digest":"f0d262b3d2344f590c24b3900d270639a49e54ca11646c40ca32abb43c935618","created_at":"2026-08-22T04:02:49+00:00","direction":"principle_to_meta","generation_trace":[],"link_id":"foundation-link:50ab2f252c61a1786a72048b","meta_principle_id":"meta:computer-science:reduction-completeness","meta_principle_revision":1,"principle_id":"prn:physics:01M0HFCCN31T42R85JCABRPFM1","principle_revision":1,"rationale":"The claim is explicitly conditional on a smooth non-adaptive quantum worst-case-to-average-case reduction and uses reduction-based reasoning to transfer hardness from NP-hard or QMA-hard problems to inverting one-way permutations. This directly depends on the meta-principle that reductions transfer difficulty and guarantees between problems.","relation_type":"depends_on","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T04:12:58+00:00","source_review_status":"unassessed","trace_id":"sync:01M0KTQZ6M68SKHPKARZR7EKFP"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T04:02:49+00:00","variable_compatibility":"compatible"}
