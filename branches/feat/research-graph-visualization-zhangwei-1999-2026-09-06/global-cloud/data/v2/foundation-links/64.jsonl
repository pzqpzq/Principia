{"condition_compatibility":"compatible","confidence":0.8,"content_digest":"521d75524c073d5204946d7a778ec7a82e8edb78b579e17ed4b5b60184b84d97","created_at":"2026-08-22T03:25:41+00:00","direction":"principle_to_meta","generation_trace":[],"link_id":"foundation-link:7a36d28f79c4f33336317679","meta_principle_id":"meta:computer-science:reduction-completeness","meta_principle_revision":1,"principle_id":"prn:biology-medicine:01M0HGNXB19XP7ZRV96BE2Y98K","principle_revision":1,"rationale":"The claim is a hardness classification of sequence-core alignment with a non-local score function: NP-hardness and MAX-SNP-hardness are established by reductions from known hard problems. This directly specializes the general reduction-completeness principle, which states that reductions transfer difficulty and guarantees between problems and organize broad classes around representative problems. The problem variables and worst-case complexity scale are compatible.","relation_type":"specializes","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T04:12:58+00:00","source_review_status":"unassessed","trace_id":"sync:01M0KTQZ6M68SKHPKARZR7EKFP"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T03:25:41+00:00","variable_compatibility":"compatible"}
