{"condition_compatibility":"compatible","confidence":0.85,"content_digest":"882b819c2a556a5a9abf490149e9217b03a15b5af56c3a1f30c39149491e5943","created_at":"2026-08-22T03:59:30+00:00","direction":"meta_to_principle","generation_trace":[],"link_id":"foundation-link:ee5770e4a100f1525276951e","meta_principle_id":"meta:computer-science:reduction-completeness","meta_principle_revision":1,"principle_id":"prn:interdisciplinary-science:01M0HJR2GX30TSDG82YKGJW005","principle_revision":1,"rationale":"The theorem follows from the completeness definition: an NP^{fp}_R-complete problem in P^{fp}_R would allow every NP^{fp}_R problem to be reduced to it and solved in P^{fp}_R, yielding equality. The meta-principle about reductions transferring difficulty and completeness organizing classes is directly applicable.","relation_type":"supports","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T04:12:58+00:00","source_review_status":"unassessed","trace_id":"sync:01M0KTQZ6M68SKHPKARZR7EKFP"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T03:59:30+00:00","variable_compatibility":"compatible"}
