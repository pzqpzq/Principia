{"condition_compatibility":"compatible","confidence":0.6,"content_digest":"82afe70171d53b9262f137649e1babaacf1869314b2fdeece302ec10c57bf17e","created_at":"2026-08-23T11:12:49+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"d11db57d3ce8304ff880e0deac179b64101cad80352fad9dabd7f6b5fc559257","input_tokens":2214,"latency_ms":33747,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"ab450d2d1203ad4b8f56a2efc62f208fd4539bb68494b04c316f3e38a77631b1","output_tokens":2393,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:129b754da3f5f577e5bb7bc3","meta_principle_id":"meta:chemistry-materials:defects-and-metastability","meta_principle_revision":1,"principle_id":"prn:physics:01M0Q54DZP837Y91QQY4Q539Q6","principle_revision":1,"rationale":"The meta-principle states that real-material strength and failure are often controlled by defects and deviations from perfect-crystal behavior. Ceramic brittle fracture, which underlies the principle's predicted susceptibility to stress spikes, is a defect-controlled failure mode, so the principle is consistent with this established materials observation.","relation_type":"consistent_with","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T15:24:41+00:00","source_review_status":"unassessed","trace_id":"sync:01M0QKJMJD3A13DCG7YJ3ACW1G"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T11:12:49+00:00","variable_compatibility":"partial"}
{"condition_compatibility":"compatible","confidence":0.85,"content_digest":"d4dc8a269fa78a19f63a3f767d096a2456f0429de49b66160cf9d7a99d06c6f6","created_at":"2026-08-22T15:35:32+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"2ff43c3d7ae36ea32a73a0b374e2fe9de2330e2082b7bbbbedfe78c45ceba915","input_tokens":5565,"latency_ms":46042,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"c413a1c5f10d487e83aa873d11cc0ef0e09a0ac4ea35cb46aac9a5d0fee42541","output_tokens":2532,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:4f7812ceabaa6405d6a35c9a","meta_principle_id":"meta:foundations:mechanism-prediction-distinction","meta_principle_revision":1,"principle_id":"prn:neuroscience-cognition:01M0N1RCD8EJPB02MWPAPT8GDH","principle_revision":1,"rationale":"The principle establishes a predictive correspondence between model internal representations and neural firing, not a mechanistic identity. The meta-principle bounds the interpretation by distinguishing predictive success from mechanistic truth, preventing the empirical association from being overread as proof that the brain uses the same recurrent-network mechanism.","relation_type":"bounded_by","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T15:35:32+00:00","variable_compatibility":"compatible"}
{"condition_compatibility":"compatible","confidence":0.8,"content_digest":"7b08825621193d10b00c3e30c3fe447d9c36435f17287977805ba9c26136153f","created_at":"2026-08-23T13:05:30+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"f0d4c90a829c02bf9fda1b559a74dfe06efb615cdf93c14eddfbea9efc88b590","input_tokens":5750,"latency_ms":43779,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"07a1a9f4a55189ee5a68f962c49ac4f83037e2081a56a417a8d1e874a8c54fe2","output_tokens":2754,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:8d6e54820b968f6e04273be6","meta_principle_id":"meta:foundations:underdetermination","meta_principle_revision":1,"principle_id":"prn:ai-ml:01M0QBJENBMJDKAHXN6D0F1KGN","principle_revision":1,"rationale":"Underdetermination says finite observations admit multiple explanations and that new measurement modalities can break equivalence. The principle's claim that expanding the observation model restores identifiability is a formal instance of this epistemic structure, with compatible conditions and no conflict in scale or variables.","relation_type":"consistent_with","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T15:24:41+00:00","source_review_status":"unassessed","trace_id":"sync:01M0QKJMJD3A13DCG7YJ3ACW1G"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T13:05:30+00:00","variable_compatibility":"compatible"}
{"condition_compatibility":"compatible","confidence":0.62,"content_digest":"e6e0f2e92b2066f4c96dad506756693150791f10988ef881eb793528be047c20","created_at":"2026-08-22T22:16:57+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"bc77f8cfc66a830ef0d3429ebd9fafc8af394c92d1e1de2bbc5e4526c7dab387","input_tokens":2495,"latency_ms":16125,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"d0751738b717191574357402c5ebaafb49b4c89033c46945c686b641920ad9e2","output_tokens":2405,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:8e185be01246f3de81ac8339","meta_principle_id":"meta:foundations:robustness-sensitivity","meta_principle_revision":1,"principle_id":"prn:ai-ml:01M0NRRAZ7KFNPFFPTWDQB14VA","principle_revision":1,"rationale":"The meta-principle requires a claimed relation to be credible across plausible perturbations and to have its generalization bounded by sensitivity analysis. The principle is explicitly study-bound to the contact-center transcript domain and the specific 3D alignment procedure, and its falsifier/testability statement calls for evaluation on different judges and corpora. Thus the meta-principle appropriately bounds the scope of the claim without asserting that the claim is true.","relation_type":"bounded_by","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T02:58:57+00:00","source_review_status":"unassessed","trace_id":"sync:01M0P5WC937PV7PKQMASBZ4D3Z"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T22:16:57+00:00","variable_compatibility":"partial"}
{"condition_compatibility":"compatible","confidence":0.68,"content_digest":"9fc80d06719c6da9858eef9b54f2bb7c8ee83bde7e19945abaa7a1c6c0fb17d1","created_at":"2026-08-23T05:31:51+00:00","direction":"principle_to_meta","generation_trace":[{"attempts":1,"input_sha256":"5fd648213c655ae97433f3acd60ae78b3baf630f976f6e290fd9926c18b67347","input_tokens":5621,"latency_ms":31489,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"e8605c4d7c5698aace37b71cd42f8677990296c87b536f3c002ccc6d9f8c03d2","output_tokens":2337,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:b582b75493285870c66a417c","meta_principle_id":"meta:mathematics-logic:fixed-point","meta_principle_revision":1,"principle_id":"prn:mathematics-logic:01M0PHM691ZN57XB4B8KX5FW6K","principle_revision":1,"rationale":"The uniqueness of the response solution among quasi-periodic solutions reducing to c0 is a specialization of fixed-point/contraction-mapping reasoning: dissipativity supplies the contractive or equivalent structure that selects a unique fixed point, and the reduction condition identifies the relevant solution branch.","relation_type":"depends_on","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-23T08:08:08+00:00","source_review_status":"unassessed","trace_id":"sync:01M0PTK9G6V6VXNVFWAWBHMSYT"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-23T05:31:51+00:00","variable_compatibility":"compatible"}
