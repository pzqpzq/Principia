{"condition_compatibility":"compatible","confidence":0.92,"content_digest":"47c1233583d69a8a47e66764dc04359f24476eb7621a7a83641ec4065af91d6b","created_at":"2026-08-22T03:59:10+00:00","direction":"principle_to_meta","generation_trace":[],"link_id":"foundation-link:c17db6faba20577401e937b8","meta_principle_id":"meta:computer-science:cook-levin-np-completeness","meta_principle_revision":1,"principle_id":"prn:interdisciplinary-science:01M0HD0ECERMMYJTBQ0HMFDDC8","principle_revision":1,"rationale":"The NP-hardness proof for the Euclidean k-Matching Problem uses a polynomial-time reduction from a SAT variant; Cook-Levin provides the foundational NP-completeness of SAT and the reduction-based transfer of hardness on which such a proof relies.","relation_type":"depends_on","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T04:12:58+00:00","source_review_status":"unassessed","trace_id":"sync:01M0KTQZ6M68SKHPKARZR7EKFP"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T03:59:10+00:00","variable_compatibility":"compatible"}
