{"condition_compatibility":"compatible","confidence":0.85,"content_digest":"7d273a5197441ea7e11fec3750dbf07515db1666b78ce4f54e5fc1603a8c0d9a","created_at":"2026-08-22T03:44:25+00:00","direction":"principle_to_meta","generation_trace":[],"link_id":"foundation-link:b79d4a1c5e31ed1d04055ed2","meta_principle_id":"meta:ai-ml:bias-variance","meta_principle_revision":1,"principle_id":"prn:general:01M0B11BB95BN7PHZ99TJC93BN","principle_revision":1,"rationale":"The claim is a specific application of the general bias-variance tradeoff to debiasing methods: methods that reduce bias more aggressively tend to show higher variance in finite samples. This directly specializes the meta-principle's decomposition of prediction error into squared bias and variance, with compatible variables (bias and variance) and conditions (finite-sample estimation).","relation_type":"specializes","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T04:12:58+00:00","source_review_status":"unassessed","trace_id":"sync:01M0KTQZ6M68SKHPKARZR7EKFP"},"review_status":"reviewed","revision":1,"scale_compatibility":"partial","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T03:44:25+00:00","variable_compatibility":"compatible"}
