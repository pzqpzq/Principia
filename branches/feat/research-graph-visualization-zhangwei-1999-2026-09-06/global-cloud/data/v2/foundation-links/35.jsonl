{"condition_compatibility":"compatible","confidence":0.55,"content_digest":"8d04172a3e0242405a5895caa69c90c61935bcd2eff8000586a12e067170c51b","created_at":"2026-08-22T14:59:43+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"952458be060d050f3098e47abfd61b01f2e8516de7783d595beeefeff6bee117","input_tokens":5561,"latency_ms":36673,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"ed940a8f50fa025f1c4cd293f7facb0488156003d52c0b8408ebaa01cc0b5ea6","output_tokens":2493,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:67db9491ff6941f1876e503b","meta_principle_id":"meta:information-control-complexity:emergence","meta_principle_revision":1,"principle_id":"prn:neuroscience-cognition:01M0MZQ2XVT6RDXTS57AXDD469","principle_revision":1,"rationale":"The emergence meta-principle states that interactions among components can produce collective functions and effective variables absent at the component scale. This supports the principle's claim that a functional subsystem can appear spontaneously and maintain its function autonomously in a self-organizing system. The relation is partial because emergence does not by itself explain takeover of another subsystem's function after damage.","relation_type":"supports","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"compatible","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T14:59:43+00:00","variable_compatibility":"partial"}
