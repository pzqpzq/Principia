{"abstract":"Nonlinear systems with model uncertainty are often described by stochastic differential equations. Some techniques from random dynamical systems are discussed. They are relevant to better understanding of solution processes of stochastic differential equations and thus may shed lights on predictability in nonlinear systems with model uncertainty.","affiliations":[],"arxiv_id":"0811.3697","authors":["Jinqiao Duan"],"availability":{"basis":"arxiv_public_full_text","checked_at":"2026-08-23T05:07:10+00:00","full_text_url":"https://arxiv.org/pdf/0811.3697.pdf","license":"arxiv-distribution","page_count":34,"pdf_bytes":527999,"status":"available"},"citation_count":null,"content_digest":"09324286262863ed8a5b280393b1cc07f080077fee7c276ca3db6de8bdb695f0","created_at":"2026-08-23T05:07:10+00:00","doi":"","identifier_observations":[],"institutions":[],"landing_url":"","legacy_ids":[],"migration_provenance":{},"openalex_id":"","pmcid":"","pmid":"","publication_date":"","revision":1,"schema_version":"global-work-v2","semantic_scholar_id":"","source_urls":[],"status":"active","title":"Predictability in Nonlinear Dynamical Systems with Model Uncertainty","updated_at":"2026-08-23T05:07:10+00:00","venue":"arXiv","work_id":"W-C8E539817F1A","year":2008}
