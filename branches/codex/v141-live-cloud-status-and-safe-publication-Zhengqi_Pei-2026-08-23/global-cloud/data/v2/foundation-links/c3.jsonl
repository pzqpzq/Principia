{"condition_compatibility":"partial","confidence":0.58,"content_digest":"845af22cff428efd31066e01ff3cf19bb89e0dd9d7e442423d6ff25fe178cf0a","created_at":"2026-08-22T14:59:05+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"f4965eeb1067b42497a0f0beef8cbbec09aef32d5e261f1cf879344fd4380ab1","input_tokens":5864,"latency_ms":44166,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"eaec5b236f39f2b743fbfce26af2e9bdebfe9a5c78db150cb1072846442aa899","output_tokens":2505,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:762eca89929f5f42f405f90f","meta_principle_id":"meta:neuroscience-cognition:homeostatic-plasticity","meta_principle_revision":1,"principle_id":"prn:neuroscience-cognition:01M0MZNQDDRCRJCRH8M37232H7","principle_revision":1,"rationale":"Homeostatic plasticity describes neural circuits stabilizing activity while retaining capacity to learn, which is a concrete mechanism consistent with the principle's claim that functional resiliency after damage implies functional plasticity as a necessary ground condition. The match is partial because the meta-principle concerns activity stabilization and learning rather than lesion-induced resiliency directly, and compensation can be maladaptive.","relation_type":"consistent_with","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"partial","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T14:59:05+00:00","variable_compatibility":"partial"}
