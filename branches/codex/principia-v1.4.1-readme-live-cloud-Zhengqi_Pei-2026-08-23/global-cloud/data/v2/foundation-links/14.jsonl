{"condition_compatibility":"partial","confidence":0.62,"content_digest":"ed34327685340284cd585ff212f6b59f96d7d699716d928c7308deca0afbc86c","created_at":"2026-08-22T14:29:05+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"b6e9b0ca3cd653bc0d80aa110d02c321743106728195d8027fbc18d081fba0e4","input_tokens":5690,"latency_ms":115480,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"39526d33667a9b926ab799372b354bf40a2494f9c2ec8dc4d85a92bc11f08ffe","output_tokens":2288,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:7c345063dd8d394138f645ee","meta_principle_id":"meta:ai-ml:no-free-lunch","meta_principle_revision":1,"principle_id":"prn:neuroscience-cognition:01M0MXWK89NST9CTAS9QWJG0X6","principle_revision":1,"rationale":"The no-free-lunch theorem says no learning algorithm dominates over unrestricted problem classes; observed practical gains reflect alignment with a nonuniform problem distribution. The claim that a 1D-CNN outperforms LASSO on this specific white-matter/cognition prediction task is a domain-specific instance of such an advantage and is consistent with the theorem, provided it is not generalized beyond the studied conditions.","relation_type":"consistent_with","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"partial","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T14:29:05+00:00","variable_compatibility":"partial"}
{"condition_compatibility":"partial","confidence":0.55,"content_digest":"767e9f8cae05bae9edd2c8050e845dc76c46f98c23d6bc20f3908a3b905ffda8","created_at":"2026-08-22T14:34:06+00:00","direction":"meta_to_principle","generation_trace":[{"attempts":1,"input_sha256":"91b5ffa8055dbad2f5af574c9e071b04e0db5de2ced19b78182cccfaca902c86","input_tokens":5460,"latency_ms":35322,"model":"deepseek-ai/DeepSeek-V4-Flash","output_sha256":"bc55bf62ad65406fc1059aa5b009bd8a3c22f0174744c39833d95f7d90a5bd91","output_tokens":2631,"prompt_sha256":"a0e24249a3438877119c33b7ce1b688152e1189df5765ebd53fae91f7c321069","prompt_template":"meta-grounding-v1","provider":"siliconflow","repair_attempted":false,"schema_valid":true,"transport_attempts":1}],"link_id":"foundation-link:bfec85303afadb1eaa1523d4","meta_principle_id":"meta:earth-climate:tipping-hysteresis","meta_principle_revision":1,"principle_id":"prn:medicine-epidemiology:01M0MY878V9YJ8758XP88TPNRJ","principle_revision":1,"rationale":"The meta-principle states that small additional forcing can trigger a large state transition in nonlinear systems with thresholds and multiple attractors. The brain-disorder principle claims that relatively small connectivity changes may suffice to produce a disorder state through nonlinear dynamics. The abstract mechanism is analogous, but the meta-principle is about Earth-system transitions and explicitly requires system-specific evidence for any particular tipping point, so it cannot establish the brain-specific claim.","relation_type":"analogous_to","review_attestation":{"actor":"principia-owner","basis":"Explicit Submit reviewed changeset confirmation in local Admin","reviewed_at":"2026-08-22T17:07:53+00:00","source_review_status":"unassessed","trace_id":"sync:01M0N72WTZDNS3VF5QZJB70PZ5"},"review_status":"reviewed","revision":1,"scale_compatibility":"partial","schema_version":"global-foundation-link-v1","status":"active","updated_at":"2026-08-22T14:34:06+00:00","variable_compatibility":"partial"}
