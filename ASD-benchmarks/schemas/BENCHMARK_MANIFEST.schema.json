{
  "type": "object",
  "required": [
    "schema",
    "benchmark",
    "version",
    "publication_authorized",
    "cases",
    "assets"
  ],
  "properties": {
    "schema": {
      "const": "principia.benchmark-manifest/v2"
    },
    "publication_authorized": {
      "type": "boolean"
    },
    "cases": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "case_revision",
          "scenario_id",
          "source_url",
          "data_origin",
          "independent_units",
          "measurement_dates",
          "asset_paths"
        ],
        "properties": {}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "path",
          "bytes",
          "sha256",
          "license_or_terms",
          "citation_url"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^scenarios/"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Principia benchmark manifest v2"
}
