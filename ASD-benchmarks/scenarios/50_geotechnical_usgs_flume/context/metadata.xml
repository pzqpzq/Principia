            <title>Utility of a swath laser rangefinder for characterizing mass movement flow depth and landslide initiation </title>
            <geoform>publication</geoform>
            <onlink>https://doi.org/10.1007/s10346-025-02533-8</onlink>
          </citeinfo>
        </lworkcit>
      </citeinfo>
